    "Anurja couldn't tell what's on this plate. Pick it from the library." : {
      "comment" : "Shown above the food library when the meal photo couldn't be recognised confidently.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anurja couldn't tell what's on this plate. Pick it from the library."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anurja पहचान नहीं पाया कि इस थाली में क्या है। इसे लाइब्रेरी से चुनें।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தத் தட்டில் என்ன இருக்கிறது என்று Anurja-வால் அறிய முடியவில்லை. நூலகத்திலிருந்து தேர்ந்தெடுங்கள்."
          }
        }
      }
    },
    "Anurja expected ↑ %lld mg/dL; your sensor showed ↑ %lld mg/dL. Anurja learns from the difference." : {
      "comment" : "A note that compares the predicted and actual glucose rise from a meal.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Anurja expected ↑ %1$lld mg/dL; your sensor showed ↑ %2$lld mg/dL. Anurja learns from the difference."
          }
        }
      }
    },
    "Anurja is not a medical device and does not give dosing advice. Always follow your care team's guidance." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anurja is not a medical device and does not give dosing advice. Always follow your care team's guidance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anurja चिकित्सा उपकरण नहीं है और खुराक की सलाह नहीं देता। हमेशा अपनी देखभाल टीम के मार्गदर्शन का पालन करें।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anurja ஒரு மருத்துவச் சாதனம் அல்ல, அளவு ஆலோசனை தராது. எப்போதும் உங்கள் பராமரிப்புக் குழுவின் வழிகாட்டுதலைப் பின்பற்றுங்கள்."
          }
        }
      }
    },
    "Anurja learns how your everyday meals shape your energy. No judgment, just your own natural pattern." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anurja learns how your everyday meals shape your energy. No judgment, just your own natural pattern."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anurja सीखता है कि रोज़ के भोजन आपकी ऊर्जा को कैसे आकार देते हैं। कोई आलोचना नहीं, बस आपका अपना स्वाभाविक पैटर्न।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தினசரி உணவு உங்கள் ஆற்றலை எப்படி வடிவமைக்கிறது என்று Anurja கற்கிறது. தீர்ப்பில்லை, உங்கள் இயற்கைப் பாங்கே."
          }
        }
      }
    },
