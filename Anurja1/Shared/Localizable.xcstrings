    "Guided by your front camera. We check your form and count clean reps. Video never leaves your phone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guided by your front camera. We check your form and count clean reps. Video never leaves your phone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे के कैमरे से मार्गदर्शन। हम मुद्रा देखते हैं और साफ़ रेप गिनते हैं। वीडियो फ़ोन से बाहर नहीं जाता।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முன் கேமரா வழிகாட்டும். உங்கள் நிலையைப் பார்த்துச் சுத்தமான முறைகளை எண்ணுகிறோம். காணொளி உங்கள் தொலைபேசியை விட்டுப் போகாது."
          }
        }
