    "Light movement after eating usually flattens the curve. Nicely done." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light movement after eating usually flattens the curve. Nicely done."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाने के बाद हल्की हरकत आमतौर पर वक्र को समतल करती है। बहुत अच्छा।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சாப்பிட்ட பின் லேசான அசைவு வழக்கமாக வளைவைத் தட்டையாக்கும். நன்றாகச் செய்தீர்கள்."
          }
        }
      }
    },
    "Light weights or a water bottle. Face the camera." : {
