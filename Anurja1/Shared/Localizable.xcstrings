            "value" : "உங்கள் பயணத்தைத் தொடங்குங்கள்"
          }
        }
      }
    },
    "Big leg muscles soak up glucose. Side-on to the camera." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Big leg muscles soak up glucose. Side-on to the camera."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैर की बड़ी मांसपेशियाँ ग्लूकोज़ सोखती हैं। कैमरे की तरफ करवट से खड़े हों।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "காலின் பெரிய தசைகள் குளுக்கோஸைப் பயன்படுத்தும். கேமராவுக்கு பக்கவாட்டில் நில்லுங்கள்."
          }
        }
      }
    },
    "Big leg muscles use glucose well. Short, guided sets are an easy way in." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Big leg muscles use glucose well. Short, guided sets are an easy way in."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैर की बड़ी मांसपेशियाँ ग्लूकोज़ अच्छे से इस्तेमाल करती हैं। छोटे, मार्गदर्शित सेट आसान शुरुआत हैं।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "காலின் பெரிய தசைகள் குளுக்கோஸை நன்றாகப் பயன்படுத்தும். குறுகிய வழிகாட்டல் தொகுப்புகள் எளிய தொடக்கம்."
          }
        }
      }
    },
