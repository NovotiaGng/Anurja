        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाने से पहले तीन धीमी साँसें आपको स्थिर कर सकती हैं।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சாப்பிடுவதற்கு முன் மூன்று மெதுவான மூச்சுகள் உங்களை அமைதிப்படுத்தும்."
