    "For two weeks, simply live your life. We'll quietly calibrate around your natural routine." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For two weeks, simply live your life. We'll quietly calibrate around your natural routine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो हफ़्ते बस अपनी ज़िंदगी जिएँ। हम चुपचाप आपकी स्वाभाविक दिनचर्या के आसपास कैलिब्रेट करेंगे।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இரண்டு வாரங்கள் உங்கள் வாழ்க்கையை வாழுங்கள். உங்கள் இயற்கை வழக்கத்தைச் சுற்றி அமைதியாக அளவீடு செய்வோம்."
          }
        }
      }
    },
