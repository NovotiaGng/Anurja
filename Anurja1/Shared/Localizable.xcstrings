    },
    "You checked in %lld times and found it hard %lld times. Whatever you pick is the right call." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You checked in %lld times and found it hard %lld times. Whatever you pick is the right call."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने %lld बार जाँच की और %lld बार कठिन पाया। आप जो भी चुनें, वही सही है।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் %lld முறை பதிவுசெய்து %lld முறை கடினமாகக் கண்டீர்கள். நீங்கள் தேர்ந்தெடுப்பதே சரி."
          }
        }
      }
    },
    "You eat at your desk and the canteen sets the menu, so we start after the meal." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You eat at your desk and the canteen sets the menu, so we start after the meal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप मेज़ पर खाते हैं और कैंटीन मेनू तय करती है, इसलिए हम भोजन के बाद से शुरू करते हैं।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் மேசையில் சாப்பிடுகிறீர்கள், உணவகம் உணவை நிர்ணயிக்கிறது, அதனால் உணவுக்குப் பிறகு தொடங்குகிறோம்."
          }
        }
      }
    },
    "You walked afterwards" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You walked afterwards"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप बाद में चले"
