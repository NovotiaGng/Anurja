    "%lld clean reps. Muscles that just worked help your body use glucose." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld clean reps. Muscles that just worked help your body use glucose."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld साफ़ रेप। अभी काम की मांसपेशियाँ शरीर को ग्लूकोज़ इस्तेमाल करने में मदद करती हैं।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld சுத்தமான முறைகள். இப்போது வேலை செய்த தசைகள் உடல் குளுக்கோஸைப் பயன்படுத்த உதவும்."
          }
        }
      }
    },
