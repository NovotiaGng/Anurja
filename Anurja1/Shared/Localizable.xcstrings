    "Add vegetables or curd and eat them first, then the rice." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add vegetables or curd and eat them first, then the rice."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब्ज़ी या दही जोड़ें और पहले उन्हें खाएँ, फिर चावल।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "காய்கறி அல்லது தயிர் சேர்த்து முதலில் அவற்றைச் சாப்பிடுங்கள், பிறகு அரிசி."
          }
        }
      }
    },
