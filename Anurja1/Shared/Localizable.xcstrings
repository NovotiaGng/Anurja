        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் தரவு இரண்டு வழியிலும் ஒன்றே."
          }
        }
      }
    },
    "YOUR FIRST TWO WEEKS" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOUR FIRST TWO WEEKS"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पहले दो हफ़्ते"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் முதல் இரண்டு வாரங்கள்"
          }
        }
      }
    },
    "Your glucose may be heading low. Follow your care team's plan." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your glucose may be heading low. Follow your care team's plan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका ग्लूकोज़ नीचे जा सकता है। अपनी देखभाल टीम की योजना का पालन करें।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் குளுக்கோஸ் குறையக்கூடும். பராமரிப்புக் குழுவின் திட்டத்தைப் பின்பற்றுங்கள்."
          }
        }
      }
    },
    "Your glucose may run high. A short walk can help; check your care team's plan if it stays high." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your glucose may run high. A short walk can help; check your care team's plan if it stays high."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका ग्लूकोज़ ऊँचा रह सकता है। थोड़ी टहल मदद कर सकती है; ऊँचा रहे तो देखभाल टीम की योजना देखें।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் குளுக்கோஸ் உயரக்கூடும். ஒரு சிறு நடை உதவும்; உயர்ந்து இருந்தால் பராமரிப்புக் குழுவின் திட்டத்தைப் பாருங்கள்."
          }
        }
      }
    },
    "Your glucose moved about +%lld mg/dL around this meal. Here is what may have played a part." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your glucose moved about +%lld mg/dL around this meal. Here is what may have played a part."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस भोजन के आसपास आपका ग्लूकोज़ लगभग +%lld मिग्रा/डेली हिला। ये बातें भूमिका निभा सकती हैं।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த உணவைச் சுற்றி உங்கள் குளுக்கோஸ் சுமார் +%lld மிகி/டெசிலி நகர்ந்தது. இவை பங்கு வகித்திருக்கலாம்."
          }
        }
      }
    },
    "Your latest glucose and time in range." : {
      "localizations" : {
