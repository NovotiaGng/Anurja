    "A night under 6 hours can make your body respond less smoothly to food." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A night under 6 hours can make your body respond less smoothly to food."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 घंटे से कम की रात शरीर की भोजन पर प्रतिक्रिया को कम सहज बना सकती है।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 மணிக்குக் குறைவான இரவு உணவுக்கு உடல் மெதுவாகப் பதிலளிக்கச் செய்யும்."
          }
        }
      }
    },
    "A sharp rise" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sharp rise"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तेज़ वृद्धि"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கூர்மையான ஏற்றம்"
          }
        }
      }
    },
    "A tiny pre-meal pause slows the first bites and is easy to repeat." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tiny pre-meal pause slows the first bites and is easy to repeat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भोजन से पहले एक छोटा विराम पहली ग्रास को धीमा करता है और दोहराना आसान है।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உணவுக்கு முன் ஒரு சிறிய இடைநிறுத்தம் முதல் வாய்வை மெதுவாக்கும், மீண்டும் செய்வதும் எளிது."
          }
        }
      }
    },
