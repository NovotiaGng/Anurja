          "stringUnit" : {
            "state" : "translated",
            "value" : "हल्के वज़न या पानी की बोतल। कैमरे की ओर मुँह करें।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "லேசான எடை அல்லது தண்ணீர் குடுவை. கேமராவைப் பார்த்து நில்லுங்கள்."
