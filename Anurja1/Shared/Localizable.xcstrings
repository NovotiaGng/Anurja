        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் முகப்புப் பலகை"
          }
        }
      }
    },
    "Your data stays the same either way." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data stays the same either way."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका डेटा दोनों तरह एक ही रहता है।"
